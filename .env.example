# Required for live trend collection.
# Used for YouTube Trends and YouTube Search.
YOUTUBE_API_KEY=your_youtube_data_api_key

# Optional defaults.
CHANNEL_NAME=Masyra Labs
TREND_REGION_CODE=US
TREND_SOURCE_LIMIT=50
TREND_TOP_N=10
SHORTS_OUTPUT_DIR=outputs
CONTENT_CATEGORIES=

# Optional licensed stock video clips. V4 uses these as fallback only.
# Options: auto, pexels, pixabay, off
VIDEO_PROVIDER=off
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional TTS.
# Options: auto, google_ai_studio, elevenlabs, piper, mock, off
TTS_PROVIDER=auto
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
GOOGLE_TTS_VOICE=Puck
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
PIPER_BIN=piper
PIPER_MODEL_PATH=/opt/masyra-shorts/models/piper/en_US-lessac-medium.onnx

# Optional scene image generation.
# Options: openai, placeholder, auto.
# openai requires OPENAI_API_KEY. placeholder is only a local fallback and is not publish-ready.
VISUAL_PROVIDER=openai
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536

# Optional AI scene video generation. Primary V5 movie path when configured.
# Options: off, auto, veo3, veo3fast, runway, kling, pixverse, hailuo, replicate, ltx, scene_image_motion
AI_VIDEO_PROVIDER_MODE=auto
AI_VIDEO_PROVIDER=auto
AI_VIDEO_PROVIDER_PRIORITY=veo3,veo3fast,runway,kling,pixverse,hailuo,replicate,ltx,scene_image_motion
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=
REPLICATE_POLL_INTERVAL_SECONDS=5
REPLICATE_TIMEOUT_SECONDS=900
# Override these only if your selected Replicate model uses different input names.
REPLICATE_PROMPT_FIELD=prompt
REPLICATE_NEGATIVE_PROMPT_FIELD=negative_prompt
REPLICATE_IMAGE_FIELD=image
REPLICATE_ASPECT_RATIO_FIELD=aspect_ratio
REPLICATE_DURATION_FIELD=duration
REPLICATE_SEED_FIELD=seed
GOOGLE_AI_API_KEY=
VEO_MODEL=veo-3
VEO_FAST_MODEL=veo-3-fast
VEO3_CREATE_URL=
VEO3_STATUS_URL_TEMPLATE=
VEO3FAST_CREATE_URL=
VEO3FAST_STATUS_URL_TEMPLATE=
KLING_API_KEY=
KLING_CREATE_URL=
KLING_STATUS_URL_TEMPLATE=
RUNWAY_API_KEY=
RUNWAY_CREATE_URL=
RUNWAY_STATUS_URL_TEMPLATE=
PIXVERSE_API_KEY=
PIXVERSE_CREATE_URL=
PIXVERSE_STATUS_URL_TEMPLATE=
HAILUO_API_KEY=
HAILUO_CREATE_URL=
HAILUO_STATUS_URL_TEMPLATE=
LTX_API_KEY=

# Upload remains disabled unless OAuth is configured and package status is Approved.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

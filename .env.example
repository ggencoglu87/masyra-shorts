# Required for live trend collection.
# Used for YouTube Trends and YouTube Search.
YOUTUBE_API_KEY=your_youtube_data_api_key

# Optional defaults.
CHANNEL_NAME=Masyra Labs
TREND_REGION_CODE=US
TREND_SOURCE_LIMIT=50
TREND_TOP_N=10
SHORTS_OUTPUT_DIR=outputs

# Optional TTS.
# Options: elevenlabs, piper, mock, off
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
PIPER_BIN=piper
PIPER_MODEL_PATH=/opt/masyra-shorts/models/piper/en_US-lessac-medium.onnx

# Optional scene image generation.
# auto uses OpenAI Images when OPENAI_API_KEY exists, then Replicate when configured,
# then local placeholder visuals.
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_VERSION=

# Upload remains disabled unless OAuth is configured and package status is Approved.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
